{
    "name": "Adobe Stock Metadata Automation",
    "description": "your life is complete now",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": ["activeTab", "storage", "scripting", "tabs"],
    "icons":{
        "16":"icon-asma3.png",
        "32":"icon-asma3.png",
        "48":"icon-asma3.png",
        "128":"icon-asma3.png"
    },
    "action":{
        "default_popup": "popup.html",
        "default_icon": "icon-asma3.png"
    },
    "background": {
        "service_workers": "background.js"
    },
    "content_scripts":[
        {
            "matches": ["https://contributor.stock.adobe.com/*/uploads*"],
            "css": ["styles.css"]
        }
    ],
    "web_accessible_resources" : [
        {
            "resources": ["icon-asma2.png"],
            "matches": ["<all_urls>"]
        }
    ],
    "host_permissions": [
        "https://api.openai.com/v1/chat/completions",
        "https://damisaas.com/asma/api/user"
    ]
}